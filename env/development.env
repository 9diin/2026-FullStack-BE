# Put real credentials in the ignored repository-root .env.local file.
DATABASE_PASSWORD=
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/postgres

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Google Gemini API
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=1600

# Source documents are currently UTF-8 plain text only.
SOURCE_FILE_MAX_BYTES=20971520
IDEA_SOURCE_MAX_CHARS=20000
